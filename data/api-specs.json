{
  "mieterportal": {
    "title": "BBL Mieterportal API",
    "version": "1.0.0",
    "format": "REST",
    "description": "Backend-Schnittstellen des Mieterportals. Das Portal ist Oberfläche, kein Mastersystem: Den Golden Record hält je Geschäftsobjekt das führende System — SAP RE-FX (Gebäude, Geschosse, Räume, Mietkonditionen), eIAM (Identitäten), DMS (Dokumente). Portaleigen sind Bedarfsmeldungen bis zur Genehmigung (danach Übergabe an SAP ePPM), Vorgänge und der Dienstleistungskatalog; die Integrationsschicht übersetzt in das jeweilige Quellsystem. Prototyp: Endpunkte gemockt, Beispiele wo möglich aus echten Portaldaten.",
    "baseUrl": "https://api.bbl.admin.ch/mieterportal/v1",
    "tokenUrl": "https://api.bbl.admin.ch/oauth2/token",
    "auth": "OAuth 2 / OIDC über eIAM (FED-LOGIN oder CH-LOGIN). Lesen erfordert mieterportal.read, Schreiben den passenden write-Scope. Schreibzugriffe auf Geschäftsobjekte verlangen If-Match (optimistisches Sperren via ETag) und akzeptieren Idempotency-Key; bestätigt wird die Übernahme durch das führende System, nicht eine Ablage im Portal.",
    "scopes": {
      "mieterportal.read": "Lesender Zugriff auf alle Ressourcen",
      "bedarf.write": "Bedarfsmeldungen erstellen, bearbeiten, einreichen, zurückziehen (LBO)",
      "pruefung.write": "Prüfentscheide erfassen (GS-Prüfung, BBL Portfolio-Management)",
      "vorgaenge.write": "Vorgänge erstellen und aktualisieren",
      "dokumente.write": "Dokumente hochladen, ändern, löschen",
      "mietverhaeltnisse.write": "Mietverhältnisse und Flächenbelegung bewirtschaften",
      "profil.write": "Eigenes Profil ändern"
    },
    "resources": [
      {
        "label": "space-requests",
        "description": "Bedarfsmeldungen (Kleinantrag / Grossantrag) — vom Entwurf bis zur Genehmigung, danach Übergabe an SAP ePPM.",
        "endpoints": [
          {
            "method": "GET",
            "path": "/space-requests",
            "summary": "Bedarfsmeldungen der eigenen Verwaltungseinheit auflisten",
            "params": [
              { "name": "status", "in": "query", "type": "string", "desc": "Status (draft, submitted, in_review_gs, clarification, in_review_pfm, in_project, approved, rejected, closed)" },
              { "name": "requestType", "in": "query", "type": "string", "desc": "Kleinantrag oder Grossantrag" },
              { "name": "ve", "in": "query", "type": "string", "desc": "Verwaltungseinheit, z. B. UVEK — über die eigene VE hinaus nur mit Prüf- oder Auditrolle" },
              { "name": "buildingId", "in": "query", "type": "string", "desc": "Gebäude, z. B. BLD-2011" },
              { "name": "page", "in": "query", "type": "integer", "desc": "Seite, ab 1" },
              { "name": "perPage", "in": "query", "type": "integer", "desc": "Treffer pro Seite, max. 200" }
            ],
            "responses": { "200": "Liste von Bedarfsmeldungen", "401": "Nicht angemeldet" },
            "responseHeaders": {
              "200": { "X-Total-Count": "Gesamtzahl der Treffer" }
            },
            "live": "space-requests.list",
            "scopes": ["mieterportal.read"]
          },
          {
            "method": "POST",
            "path": "/space-requests",
            "summary": "Neue Bedarfsmeldung als Entwurf erstellen",
            "params": [
              { "name": "Idempotency-Key", "in": "header", "type": "string", "desc": "UUID; Wiederholung liefert die erste Antwort statt eines Duplikats" }
            ],
            "body": {
              "requestType": "Kleinantrag",
              "pipelineVariant": "standard",
              "buildingId": "BLD-2011",
              "fte": 8,
              "naw": { "class": "Kollaborativ-Standard" },
              "begruendung": "Zusätzliche Arbeitsplätze für befristetes Projektteam"
            },
            "responses": {
              "201": "Entwurf erstellt",
              "400": "Validierung fehlgeschlagen",
              "401": "Nicht angemeldet",
              "403": "Fehlende Berechtigung",
              "422": "Fachliche Validierung fehlgeschlagen"
            },
            "responseHeaders": {
              "201": { "Location": "URL der neuen Bedarfsmeldung", "ETag": "Version des neuen Datensatzes" }
            },
            "example": {
              "spaceRequestId": "BE-2026-021",
              "requestType": "Kleinantrag",
              "pipelineVariant": "standard",
              "status": "draft",
              "buildingId": "BLD-2011",
              "fte": 8,
              "workstations": 7,
              "hnf2": 77,
              "createdAt": "2026-08-13T09:12:00Z"
            },
            "scopes": ["bedarf.write"]
          },
          {
            "method": "GET",
            "path": "/space-requests/{id}",
            "summary": "Eine Bedarfsmeldung mit Flächenkennzahlen (HNF2, GF) und NAW-Einstufung abrufen",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Antrags-ID, z. B. BE-2026-014" }
            ],
            "responses": { "200": "Bedarfsmeldung", "401": "Nicht angemeldet", "404": "Nicht gefunden" },
            "responseHeaders": {
              "200": { "ETag": "Version für If-Match bei Schreibzugriffen" }
            },
            "live": "space-requests.one",
            "scopes": ["mieterportal.read"]
          },
          {
            "method": "PATCH",
            "path": "/space-requests/{id}",
            "summary": "Entwurf oder Rückfrage aktualisieren (Teilupdate)",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Antrags-ID" },
              { "name": "If-Match", "in": "header", "type": "string", "required": true, "desc": "ETag der zuletzt gelesenen Version" }
            ],
            "body": { "fte": 10, "workstations": 8, "begruendung": "Teamerweiterung bestätigt" },
            "responses": {
              "200": "Aktualisierte Bedarfsmeldung",
              "400": "Validierung fehlgeschlagen",
              "401": "Nicht angemeldet",
              "403": "Fehlende Berechtigung",
              "404": "Nicht gefunden",
              "409": "Statuskonflikt — nur Entwürfe und Rückfragen sind änderbar",
              "412": "Vorbedingung fehlgeschlagen",
              "422": "Fachliche Validierung fehlgeschlagen",
              "428": "Vorbedingung erforderlich"
            },
            "scopes": ["bedarf.write"]
          },
          {
            "method": "DELETE",
            "path": "/space-requests/{id}",
            "summary": "Entwurf zurückziehen",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Antrags-ID" },
              { "name": "If-Match", "in": "header", "type": "string", "required": true, "desc": "ETag der zuletzt gelesenen Version" }
            ],
            "responses": {
              "204": "Zurückgezogen",
              "401": "Nicht angemeldet",
              "403": "Fehlende Berechtigung",
              "404": "Nicht gefunden",
              "409": "Statuskonflikt — nur Entwürfe können zurückgezogen werden",
              "412": "Vorbedingung fehlgeschlagen"
            },
            "scopes": ["bedarf.write"]
          },
          {
            "method": "POST",
            "path": "/space-requests/{id}/submit",
            "summary": "Entwurf einreichen (Statusübergang draft → submitted)",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Antrags-ID" },
              { "name": "If-Match", "in": "header", "type": "string", "required": true, "desc": "ETag der zuletzt gelesenen Version" }
            ],
            "responses": {
              "200": "Eingereicht — der zugehörige Vorgang erscheint unter /process-instances",
              "401": "Nicht angemeldet",
              "403": "Fehlende Berechtigung",
              "404": "Nicht gefunden",
              "409": "Statuskonflikt — bereits eingereicht",
              "412": "Vorbedingung fehlgeschlagen",
              "422": "Fachliche Validierung fehlgeschlagen — Pflichtangaben oder Checkliste unvollständig"
            },
            "example": { "spaceRequestId": "BE-2026-021", "status": "submitted", "submittedAt": "2026-08-13T09:30:00Z" },
            "scopes": ["bedarf.write"]
          },
          {
            "method": "POST",
            "path": "/space-requests/{id}/decision",
            "summary": "Prüfentscheid erfassen: approved, clarification (mit Auflagen) oder rejected",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Antrags-ID" },
              { "name": "If-Match", "in": "header", "type": "string", "required": true, "desc": "ETag der zuletzt gelesenen Version" }
            ],
            "body": {
              "decision": "approved",
              "comment": "Flächenbedarf plausibel, NAW-Einstufung bestätigt.",
              "conditions": ["Desk-Sharing-Faktor 0.8 einhalten"]
            },
            "responses": {
              "200": "Entscheid erfasst — Status und Historie aktualisiert",
              "400": "Validierung fehlgeschlagen",
              "401": "Nicht angemeldet",
              "403": "Fehlende Berechtigung — Entscheid erfordert eine Prüfrolle",
              "404": "Nicht gefunden",
              "409": "Statuskonflikt — Meldung ist nicht in Prüfung",
              "412": "Vorbedingung fehlgeschlagen",
              "422": "Fachliche Validierung fehlgeschlagen"
            },
            "example": { "spaceRequestId": "BE-2026-014", "status": "approved", "decidedBy": "U.654.321", "decidedAt": "2026-08-13T10:02:00Z" },
            "scopes": ["pruefung.write"]
          },
          {
            "method": "GET",
            "path": "/space-requests/{id}/history",
            "summary": "Verlauf einer Bedarfsmeldung abrufen (Audit-Trail, nur lesend)",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Antrags-ID" }
            ],
            "responses": { "200": "Chronologische Ereignisliste", "401": "Nicht angemeldet", "404": "Nicht gefunden" },
            "live": "space-requests.history",
            "scopes": ["mieterportal.read"]
          },
          {
            "method": "POST",
            "path": "/space-requests/{id}/attachments",
            "summary": "Anhang registrieren (Metadaten + Upload-Referenz)",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Antrags-ID" },
              { "name": "Idempotency-Key", "in": "header", "type": "string", "desc": "UUID; Wiederholung liefert die erste Antwort statt eines Duplikats" }
            ],
            "body": { "name": "WiBe.pdf", "size": "1.2 MB", "uploadRef": "upl_9f2c41" },
            "responses": {
              "201": "Anhang registriert; Virenprüfung läuft asynchron (scanStatus pending → ok)",
              "400": "Validierung fehlgeschlagen",
              "401": "Nicht angemeldet",
              "403": "Fehlende Berechtigung",
              "404": "Nicht gefunden",
              "422": "Fachliche Validierung fehlgeschlagen — Dateityp oder Grösse unzulässig"
            },
            "example": { "name": "WiBe.pdf", "size": "1.2 MB", "scanStatus": "pending" },
            "scopes": ["bedarf.write"]
          },
          {
            "method": "DELETE",
            "path": "/space-requests/{id}/attachments/{name}",
            "summary": "Anhang entfernen",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Antrags-ID" },
              { "name": "name", "in": "path", "type": "string", "required": true, "desc": "Dateiname des Anhangs, z. B. WiBe.pdf" }
            ],
            "responses": {
              "204": "Entfernt",
              "401": "Nicht angemeldet",
              "403": "Fehlende Berechtigung",
              "404": "Nicht gefunden",
              "409": "Statuskonflikt — Anhänge eingereichter Meldungen sind unveränderlich"
            },
            "scopes": ["bedarf.write"]
          }
        ]
      },
      {
        "label": "process-instances",
        "description": "Geschäftsfälle, die das Portal auslöst und verfolgt (Bedarfsmeldung, Schadensmeldung, Umzug, Sonderreinigung, Möbelbestellung).",
        "endpoints": [
          {
            "method": "GET",
            "path": "/process-instances",
            "summary": "Vorgänge der angemeldeten Person auflisten",
            "params": [
              { "name": "status", "in": "query", "type": "string", "desc": "Status (submitted, scheduled, in_progress, in_review_gs, clarification, in_review_pfm, in_project, approved, rejected, closed, cancelled)" },
              { "name": "defId", "in": "query", "type": "string", "desc": "Prozessdefinition (bedarfsmeldung, schadensmeldung, umzug, sonderreinigung, moebelbestellung)" },
              { "name": "page", "in": "query", "type": "integer", "desc": "Seite, ab 1" },
              { "name": "perPage", "in": "query", "type": "integer", "desc": "Treffer pro Seite, max. 200" }
            ],
            "responses": { "200": "Liste von Vorgängen", "401": "Nicht angemeldet" },
            "responseHeaders": {
              "200": { "X-Total-Count": "Gesamtzahl der Treffer" }
            },
            "live": "process-instances.list",
            "scopes": ["mieterportal.read"]
          },
          {
            "method": "POST",
            "path": "/process-instances",
            "summary": "Neuen Vorgang aus einer Dienstleistung erstellen",
