              "400": "Validierung fehlgeschlagen",
              "401": "Nicht angemeldet",
              "403": "Fehlende Berechtigung",
              "422": "Fachliche Validierung fehlgeschlagen"
            },
            "responseHeaders": {
              "201": { "Location": "URL des neuen Vorgangs", "ETag": "Version des neuen Vorgangs" }
            },
            "example": {
              "instanceId": "VG-2026-0198",
              "defId": "schadensmeldung",
              "variant": "standard",
              "status": "submitted",
              "buildingId": "BLD-2010",
              "createdAt": "2026-08-13T08:47:00Z"
            },
            "scopes": ["vorgaenge.write"]
          },
          {
            "method": "GET",
            "path": "/process-instances/{id}",
            "summary": "Einen Vorgang mit Status und Zuständigkeit abrufen",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Vorgangs-ID, z. B. VG-2026-0142" }
            ],
            "responses": { "200": "Vorgang", "401": "Nicht angemeldet", "404": "Nicht gefunden" },
            "responseHeaders": {
              "200": { "ETag": "Version für If-Match bei Schreibzugriffen" }
            },
            "live": "process-instances.one",
            "scopes": ["mieterportal.read"]
          },
          {
            "method": "PATCH",
            "path": "/process-instances/{id}",
            "summary": "Status oder Zuständigkeit aktualisieren (Sachbearbeitung); Abbruch = Statusübergang cancelled",
            "params": [
              { "name": "id", "in": "path", "type": "string", "required": true, "desc": "Vorgangs-ID" },
              { "name": "If-Match", "in": "header", "type": "string", "required": true, "desc": "ETag der zuletzt gelesenen Version" }
